.page {
    box-sizing: border-box;
    min-height: 100vh;
    padding: 32rpx 28rpx 64rpx;
}

.hero {
    position: relative;
    display: flex;
    overflow: hidden;
    box-sizing: border-box;
    padding: 42rpx 36rpx;
    border-radius: 28rpx;
    background: linear-gradient(135deg, #102d3d 0%, #14536a 100%);
    box-shadow: 0 16rpx 40rpx rgba(16, 45, 61, 0.16);
    flex-direction: column;
}

.hero::after {
    position: absolute;
    top: -100rpx;
    right: -70rpx;
    width: 300rpx;
    height: 300rpx;
    border: 44rpx solid rgba(118, 213, 219, 0.08);
    border-radius: 50%;
    content: '';
}

.hero-badge {
    align-self: flex-start;
    padding: 8rpx 14rpx;
    border: 1rpx solid rgba(160, 226, 230, 0.35);
    border-radius: 8rpx;
    color: #9ce0e2;
    font-size: 18rpx;
    font-weight: 600;
    letter-spacing: 2rpx;
}

.hero-title {
    margin-top: 24rpx;
    color: #ffffff;
    font-size: 50rpx;
    font-weight: 700;
    letter-spacing: 2rpx;
}

.hero-subtitle {
    margin-top: 12rpx;
    color: #d3edf0;
    font-size: 27rpx;
}

.hero-rule {
    width: 54rpx;
    height: 5rpx;
    margin: 28rpx 0 18rpx;
    border-radius: 4rpx;
    background: #68cdd1;
}

.hero-note {
    color: #a9c8d1;
    font-size: 23rpx;
}

.tab-bar {
    display: flex;
    margin: 28rpx 0 24rpx;
    padding: 6rpx;
    border: 2rpx solid #e2e9ec;
    border-radius: 18rpx;
    background: #ffffff;
}

.tab-item {
    flex: 1;
    padding: 18rpx 0;
    border-radius: 12rpx;
    color: #65747d;
    font-size: 28rpx;
    font-weight: 500;
    text-align: center;
}

.tab-active {
    background: #e8f4f6;
    color: #12627c;
    font-weight: 600;
}

.mode-switch {
    display: flex;
    margin-bottom: 20rpx;
}

.mode-item {
    display: flex;
    box-sizing: border-box;
    flex: 1;
    padding: 24rpx;
    border: 2rpx solid #dfe7ea;
    border-radius: 20rpx;
    background: #ffffff;
    flex-direction: column;
}

.mode-item + .mode-item {
    margin-left: 16rpx;
}

.mode-active {
    border-color: #2a8ca6;
    background: #f0f8f9;
    box-shadow: inset 0 0 0 2rpx rgba(42, 140, 166, 0.08);
}

.mode-title {
    color: #21343d;
    font-size: 29rpx;
    font-weight: 600;
}

.mode-active .mode-title {
    color: #12627c;
}

.mode-caption {
    margin-top: 8rpx;
    color: #819098;
    font-size: 22rpx;
}

.convention-card {
    display: flex;
    margin-bottom: 24rpx;
    padding: 22rpx 24rpx;
    border-left: 6rpx solid #4a9fb1;
    border-radius: 12rpx;
    background: #eaf4f5;
    flex-direction: column;
}

.convention-title {
    color: #285866;
    font-size: 24rpx;
    font-weight: 600;
}

.convention-text {
    margin-top: 8rpx;
    color: #57717a;
    font-size: 22rpx;
    line-height: 1.65;
}

.error-banner,
.warning-card {
    display: flex;
    margin-bottom: 24rpx;
    padding: 24rpx;
    border: 2rpx solid #f0c8c2;
    border-radius: 18rpx;
    background: #fff4f2;
    flex-direction: column;
}

.error-title,
.warning-title {
    color: #a53d35;
    font-size: 26rpx;
    font-weight: 600;
}

.error-item,
.warning-item {
    margin-top: 10rpx;
    color: #a54b43;
    font-size: 23rpx;
    line-height: 1.5;
}

.form-section,
.detail-card {
    margin-bottom: 24rpx;
    padding: 30rpx;
    border: 2rpx solid #e3eaed;
    border-radius: 24rpx;
    background: #ffffff;
    box-shadow: 0 6rpx 20rpx rgba(28, 54, 65, 0.035);
}

.section-heading {
    display: flex;
    align-items: center;
    margin-bottom: 26rpx;
}

.section-index {
    margin-right: 14rpx;
    color: #3b95a9;
    font-size: 22rpx;
    font-weight: 700;
    letter-spacing: 1rpx;
}

.section-title {
    color: #1e343e;
    font-size: 31rpx;
    font-weight: 600;
}

.field {
    box-sizing: border-box;
    margin-top: 24rpx;
}

.section-heading + .field,
.section-heading + .field-row .field {
    margin-top: 0;
}

.field-row {
    display: flex;
    margin-top: 24rpx;
}

.field-row .field {
    min-width: 0;
    flex: 1;
}

.field-half + .field-half {
    margin-left: 18rpx;
}

.field-label {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 12rpx;
    color: #334852;
    font-size: 25rpx;
    font-weight: 500;
}

.field-unit {
    margin-left: 12rpx;
    color: #87969e;
    font-size: 21rpx;
    font-weight: 400;
}

.field-input {
    box-sizing: border-box;
    width: 100%;
    height: 82rpx;
    padding: 0 22rpx;
    border: 2rpx solid #d7e0e4;
    border-radius: 14rpx;
    background: #f9fbfc;
    color: #152d37;
    font-size: 29rpx;
}

.field-input-static {
    display: flex;
    align-items: center;
    color: #6b7f88;
    background: #eef3f5;
    font-size: 26rpx;
}

.field-help {
    display: block;
    margin-top: 9rpx;
    color: #87969e;
    font-size: 20rpx;
    line-height: 1.45;
}

.field-error-border .field-input {
    border-color: #d67a70;
    background: #fff8f7;
}

.field-error {
    display: block;
    margin-top: 8rpx;
    color: #b3453c;
    font-size: 21rpx;
    line-height: 1.45;
}

.switch-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: 24rpx;
    padding: 22rpx;
    border-radius: 16rpx;
    background: #f2f7f8;
}

.switch-copy {
    display: flex;
    padding-right: 20rpx;
    flex: 1;
    flex-direction: column;
}

.switch-title {
    color: #2a444f;
    font-size: 25rpx;
    font-weight: 500;
}

.switch-caption {
    margin-top: 7rpx;
    color: #7b8d95;
    font-size: 20rpx;
    line-height: 1.45;
}

.action-row {
    display: flex;
    margin: 30rpx 0;
}

.action-row button::after,
.history-header button::after,
.history-card button::after {
    border: 0;
}

.secondary-button,
.calculate-button {
    height: 90rpx;
    font-size: 29rpx;
    font-weight: 600;
    line-height: 90rpx;
}

.secondary-button {
    width: 32%;
    margin: 0 16rpx 0 0;
    border: 2rpx solid #cddde2;
    background: #ffffff;
    color: #45636f;
}

.calculate-button {
    flex: 1;
    margin: 0;
    background: #176f89;
    box-shadow: 0 10rpx 24rpx rgba(23, 111, 137, 0.2);
    color: #ffffff;
}

.result-section {
    padding-top: 10rpx;
}

.result-heading {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin: 20rpx 4rpx;
}

.result-heading > view:first-child {
    display: flex;
    flex-direction: column;
}

.result-kicker {
    color: #6a8b96;
    font-size: 18rpx;
    font-weight: 600;
    letter-spacing: 2rpx;
}

.result-title {
    margin-top: 6rpx;
    color: #17333f;
    font-size: 36rpx;
    font-weight: 700;
}

.migration-badge {
    padding: 10rpx 20rpx;
    border-radius: 24rpx;
    background: #e6f3ef;
    color: #27735c;
    font-size: 24rpx;
    font-weight: 600;
}

.migration-negative {
    background: #e8eff8;
    color: #3b628d;
}

.result-primary {
    display: flex;
    padding: 36rpx 30rpx;
    border-radius: 24rpx;
    background: #123f52;
    box-shadow: 0 12rpx 30rpx rgba(18, 63, 82, 0.15);
    flex-direction: column;
}

.result-label {
    color: #a7cbd4;
    font-size: 24rpx;
}

.range-value {
    margin-top: 14rpx;
    color: #ffffff;
    font-size: 39rpx;
    font-weight: 700;
    letter-spacing: 1rpx;
}

.range-track {
    overflow: hidden;
    height: 6rpx;
    margin-top: 28rpx;
    border-radius: 6rpx;
    background: rgba(255, 255, 255, 0.15);
}

.range-fill {
    width: 100%;
    height: 100%;
    background: linear-gradient(90deg, #67cdd0, #b2e6df);
}

.range-labels {
    display: flex;
    justify-content: space-between;
    margin-top: 12rpx;
    color: #b5d3da;
    font-size: 21rpx;
}

.metric-row {
    display: flex;
    margin: 18rpx 0 24rpx;
}

.metric-card {
    display: flex;
    box-sizing: border-box;
    flex: 1;
    padding: 26rpx;
    border: 2rpx solid #e0e9ec;
    border-radius: 20rpx;
    background: #ffffff;
    flex-wrap: wrap;
}

.metric-card + .metric-card {
    margin-left: 16rpx;
}

.metric-label {
    width: 100%;
    color: #71858e;
    font-size: 23rpx;
}

.metric-value {
    margin-top: 12rpx;
    color: #193f4e;
    font-size: 38rpx;
    font-weight: 700;
}

.metric-unit {
    align-self: flex-end;
    margin: 0 0 5rpx 8rpx;
    color: #7b8e96;
    font-size: 22rpx;
}

.warning-card {
    border-color: #ead7aa;
    background: #fff9eb;
}

.warning-title,
.warning-item {
    color: #8a6724;
}

.static-card {
    margin-bottom: 24rpx;
    padding: 28rpx;
    border: 2rpx solid;
    border-radius: 20rpx;
}

.static-pass {
    border-color: #bfddd2;
    background: #f1f9f6;
}

.static-fail {
    border-color: #e5b5ad;
    background: #fff4f2;
}

.static-heading,
.static-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
}

.static-title {
    color: #2a474f;
    font-size: 28rpx;
    font-weight: 600;
}

.static-status {
    color: #34725e;
    font-size: 23rpx;
    font-weight: 600;
}

.static-fail .static-status {
    color: #ac453c;
}

.static-range {
    display: block;
    margin: 14rpx 0 18rpx;
    color: #647c84;
    font-size: 22rpx;
}

.static-row {
    padding: 13rpx 0;
    border-top: 1rpx solid rgba(80, 110, 120, 0.12);
    color: #476069;
    font-size: 22rpx;
    line-height: 1.5;
}

.static-row text:last-child {
    max-width: 58%;
    text-align: right;
}

.static-note {
    display: block;
    margin-top: 14rpx;
    color: #87969e;
    font-size: 20rpx;
    line-height: 1.5;
}

.detail-title {
    display: block;
    margin-bottom: 12rpx;
    color: #213e49;
    font-size: 29rpx;
    font-weight: 600;
}

.step-item {
    display: flex;
    padding: 22rpx 0;
    border-top: 2rpx solid #edf1f2;
    flex-direction: column;
}

.step-title {
    color: #2f4d58;
    font-size: 25rpx;
    font-weight: 600;
}

.step-formula {
    margin-top: 10rpx;
    color: #347a8d;
    font-size: 22rpx;
    line-height: 1.6;
}

.step-value {
    margin-top: 8rpx;
    color: #667b84;
    font-size: 22rpx;
    line-height: 1.6;
}

.input-summary {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    padding: 17rpx 0;
    border-top: 2rpx solid #edf1f2;
    font-size: 22rpx;
    line-height: 1.5;
}

.summary-label {
    padding-right: 20rpx;
    color: #73868e;
    flex: 1;
}

.summary-value {
    max-width: 58%;
    color: #344f59;
    text-align: right;
}

.history-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin: 12rpx 2rpx 24rpx;
}

.history-header > view {
    display: flex;
    flex-direction: column;
}

.history-title {
    color: #1c3945;
    font-size: 34rpx;
    font-weight: 700;
}

.history-caption {
    margin-top: 8rpx;
    color: #7b8e96;
    font-size: 22rpx;
}

.clear-button,
.delete-button {
    margin: 0;
    background: #ffffff;
    color: #a34c45;
    font-size: 23rpx;
}

.empty-card {
    display: flex;
    min-height: 360rpx;
    align-items: center;
    justify-content: center;
    border: 2rpx dashed #d6e1e5;
    border-radius: 24rpx;
    background: #ffffff;
    flex-direction: column;
}

.empty-symbol {
    color: #8ca8b2;
    font-size: 58rpx;
}

.empty-title {
    margin-top: 18rpx;
    color: #49636e;
    font-size: 29rpx;
    font-weight: 600;
}

.empty-caption {
    margin-top: 10rpx;
    color: #8a9ba2;
    font-size: 23rpx;
}

.history-card {
    display: flex;
    margin-bottom: 20rpx;
    padding: 28rpx;
    border: 2rpx solid #e0e8eb;
    border-radius: 22rpx;
    background: #ffffff;
    flex-direction: column;
}

.history-top,
.history-bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
}

.history-mode {
    padding: 6rpx 14rpx;
    border-radius: 10rpx;
    background: #eaf4f5;
    color: #327486;
    font-size: 21rpx;
}

.history-time {
    color: #8a9aa1;
    font-size: 21rpx;
}

.history-range {
    margin-top: 22rpx;
    color: #193d4b;
    font-size: 32rpx;
    font-weight: 700;
}

.history-migration {
    margin-top: 8rpx;
    color: #57717b;
    font-size: 24rpx;
}

.history-bottom {
    margin-top: 20rpx;
    padding-top: 16rpx;
    border-top: 2rpx solid #edf1f2;
}

.history-static {
    color: #6d838b;
    font-size: 22rpx;
}

.history-load {
    margin-top: 8rpx;
    color: #96a5ab;
    font-size: 19rpx;
}

.footer-note {
    margin-top: 32rpx;
    padding: 0 12rpx;
    color: #89979d;
    font-size: 20rpx;
    line-height: 1.7;
    text-align: center;
}
